{
  "name": "action-deploy-surecart",
  "version": "2.0.0",
  "description": "GitHub Action that deploys a release to SureCart. v1 mode: attach existing media to products. v2 mode: pull a release asset from GitHub, upload to Cloudflare R2, attach the external URL to products.",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc && esbuild dist/index.js --bundle --platform=node --target=node24 --outfile=dist/index.js --conditions=import --format=cjs --allow-overwrite",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "github-action",
    "surecart",
    "cloudflare-r2",
    "wordpress"
  ],
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "esbuild": "^0.27.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
